{
  "name": "dsh-impeccable",
  "version": "0.1.0",
  "description": "Impeccable design suite for DSH: bundled design skill, native UI anti-pattern detector hooks, accelerated slash commands, and a Web Design Studio panel.",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "impeccable",
    "design-system",
    "ui",
    "plugin"
  ],
  "homepage": "https://github.com/Cassius0924/dsh-impeccable#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cassius0924/dsh-impeccable.git"
  },
  "bugs": {
    "url": "https://github.com/Cassius0924/dsh-impeccable/issues"
  },
  "author": "Cassius0924",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.mjs",
    "prepare": "node build.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
